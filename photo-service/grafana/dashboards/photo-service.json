{
  "title": "Photo Service",
  "uid": "photo-service",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Uploads per minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(photos_uploaded_total[1m])) * 60",
          "legendFormat": "uploads/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Analysis duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(photo_analysis_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 duration (s)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Failed analyses",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(photo_analysis_failed_total[5m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Pending photos",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "max(photos_pending{job=\"photo-api\"})",
          "legendFormat": "pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Prepared image size (analyzer_image_prepared_bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(analyzer_image_prepared_bytes_bucket[5m])) by (le))",
          "legendFormat": "p50 bytes",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(analyzer_image_prepared_bytes_bucket[5m])) by (le))",
          "legendFormat": "p95 bytes",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Downscaled images (rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(analyzer_image_downscaled_total[5m]))",
          "legendFormat": "downscaled/s",
          "refId": "A"
        }
      ]
    }
  ]
}
