# App
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://photo:photo@postgres:5432/photo_db

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=photos
MINIO_SECURE=false

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_ANALYSIS_REQUESTED=photo.analysis.requested
KAFKA_CONSUMER_GROUP=photo-analysis-workers
KAFKA_PUBLISH_TIMEOUT_SECONDS=10.0

# Analyzer (gRPC)
ANALYZER_GRPC_ADDR=analyzer-stub:50051
ANALYZER_GRPC_TIMEOUT=30.0

# Worker retry/backoff
WORKER_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=1.0

# Metrics
WORKER_METRICS_PORT=8001

# Outbox publisher
OUTBOX_POLL_INTERVAL_SECONDS=2.0
OUTBOX_BATCH_SIZE=100

# Grafana admin credentials - local dev default only, MUST be overridden
# in any non-local environment (docker-compose.yml reads these via
# ${GRAFANA_ADMIN_USER:-admin} / ${GRAFANA_ADMIN_PASSWORD:-admin_dev_only}).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev_only
